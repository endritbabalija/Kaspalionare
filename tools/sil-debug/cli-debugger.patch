+
+fn sdbx_daa(i: usize) -> u64 {
+    std::env::var("SDB_INPUT_DAA").ok().and_then(|v| v.split(',').nth(i).map(|x| x.trim().parse().expect("daa"))).unwrap_or(0)
+}
+
+struct SdbxSeqCommit {
+    block: Hash,
+    commit: Hash,
+}
+
+impl SdbxSeqCommit {
+    fn from_env() -> Option<Self> {
+        let v = std::env::var("SDB_SEQ_COMMIT").ok()?;
+        let (b, c) = v.split_once('=')?;
+        Some(Self { block: parse_hash32(b).ok()?, commit: parse_hash32(c).ok()? })
+    }
+}
+
+impl kaspa_txscript::SeqCommitAccessor for SdbxSeqCommit {
+    fn is_chain_ancestor_from_pov(&self, block_hash: Hash) -> Option<bool> {
+        Some(block_hash == self.block)
+    }
+    fn seq_commitment_within_depth(&self, block_hash: Hash) -> Option<Hash> {
+        (block_hash == self.block).then_some(self.commit)
+    }
+}

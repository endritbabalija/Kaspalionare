pragma silverscript ^0.1.0;

// Frozen marker (role 0x03) of one round, spec M2 A3.3 (layout unchanged, spec M3 A3.4).
// M3 replaces the M2 placeholder (D28) with one entry, draw_leg(): the marker is a delegate
// of Drawer.draw_test_seed() at input 1 (spec M3 A4 delegate legs, D37, D38).
//
// Value: S - P_R - C_close + J_boost + R. Created only by Controller.close(), which
// validates every field (spec M2 A4 check 24).
contract Marker(
    byte[32] drawerTemplateHash,
    int init_round,
    int init_k,
    byte[512] init_roots,
    int init_sales,
    int init_ref_paid,
    int init_m,
    int init_jackpot,
    int init_j_boost,
    int init_g2,
    int init_sf,
    int init_sr,
    int init_sc,
    int init_sd,
    int init_st1,
    int init_st2,
    int init_st3,
    int init_st4,
    int init_st5,
    int init_seed_ref,
    byte init_funder_class,
    byte[33] init_funder_key
) {
    // roots: 32 x K_MAX bytes (K_MAX = 16); roots i >= k are all zero.

    byte role = 0x03;
    int round = init_round;
    int k = init_k;
    byte[512] roots = init_roots;
    int sales = init_sales;
    int ref_paid = init_ref_paid;
    int m = init_m;
    int jackpot = init_jackpot;
    int j_boost = init_j_boost;
    int g2 = init_g2;
    int s_f = init_sf;
    int s_r = init_sr;
    int s_c = init_sc;
    int s_d = init_sd;
    int st1 = init_st1;
    int st2 = init_st2;
    int st3 = init_st3;
    int st4 = init_st4;
    int st5 = init_st5;
    int seed_ref = init_seed_ref;
    byte funder_class = init_funder_class;
    byte[33] funder_key = init_funder_key;

    // Largest accepted template prefix/suffix length argument (rusty-kaspa v2.1.0
    // crypto/txscript/src/lib.rs:78, MAX_SCRIPTS_SIZE = 1,000,000).
    int constant SCRIPT_MAX = 1000000;

    // Drawer state layout (spec M3 A3.1), for readInputStateWithTemplate.
    struct DrawerState {
        byte role;
        int round;
        byte[32] pool_tpl;
        byte[32] vault_tpl;
        int f_min;
        int claim_window;
        int draw_window;
    }

    // Delegate leg of Drawer.draw_test_seed() (spec M3 A4, marker L1-L4).
    entry draw_leg(int drawer_pl, int drawer_sl) {
        // L1: the marker slot of draw()
        require(this.activeInputIndex == 1); // mut:ML1
        // L2: the leader carries this covenant ID
        byte[32] cov = OpInputCovenantId(1);
        require(OpInputCovenantId(0) == cov); // mut:ML2
        // L3: this input authorizes no output
        require(OpAuthOutputCount(1) == 0); // mut:ML3
        // L4: the leader is the drawer of this round under the committed template
        require(drawer_pl >= 0);
        require(drawer_pl <= SCRIPT_MAX);
        require(drawer_sl >= 0);
        require(drawer_sl <= SCRIPT_MAX);
        DrawerState drw = readInputStateWithTemplate(0, drawer_pl, drawer_sl, drawerTemplateHash);
        require(unsigned(drw.role) == 10); // mut:ML4_role
        require(drw.round == round); // mut:ML4_round
    }
}

{
  "name": "kaspalionare-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kaspalionare testnet-10 beta page (front end F3+). Commands: web/CLAUDE.md.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:simnet": "node scripts/dev-simnet.mjs",
    "dev": "vite",
    "wasm:dev": "node scripts/wasm.mjs dev",
    "wasm:release": "node scripts/wasm.mjs release",
    "build": "node scripts/wasm.mjs release && tsc -b && vite build && node scripts/check-bundle.mjs",
    "check:mainnet": "node scripts/check-mainnet.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test": "node scripts/ensure-wasm.mjs && npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "e2e": "playwright test",
    "e2e:install": "node scripts/playwright-install.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-slot": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "binaryen": "131.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "geist": "1.7.2",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "overrides": {
    "playwright-core": "1.64.0"
  }
}

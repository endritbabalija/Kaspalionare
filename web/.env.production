# The testnet-10 beta page's build configuration (spec frontend 6.5; src/config.ts). Nothing here is secret: every
# value ends up in the public page, so web/.env.production is committed with vercel.json (git ignores only Vite's
# *.local overrides). Copy this file to web/.env.production, fill it in, then follow
# docs/launch/site-deploy.md (npm run csp:write puts the indexer's origin into vercel.json's CSP).
# Every address is a kaspatest: one; a kaspa: (mainnet) value is refused by the build checks.

# The network: testnet-10 only (a production build refuses anything else).
VITE_NETWORK=testnet-10

# The hosted indexer API, ending in /v1/ (docs/launch/indexer-server.md). https only. Several, comma-separated, are
# asked in order with fallback (F6 part E): the page moves on from one that is down, hangs or serves answers its
# checks refuse, and remembers in each browser the one that last answered. At most 8. Each origin goes into the
# CSP (npm run csp:write). The entry /api/v1/ is the indexer through the site's own address (the Vercel proxy
# below; docs/launch/site-deploy.md).
VITE_INDEXER_URL=https://172-104-238-197.sslip.io/v1/

# Optional (F6 part E, not in the page): the indexer server's origin for the Vercel proxy, for example
# http://203.0.113.5 or https://api.example.org. npm run csp:write then writes the rewrite
# /api/v1/:path* -> <origin>/v1/:path* into vercel.json, and VITE_INDEXER_URL may list /api/v1/.
# Read docs/launch/site-deploy.md "The indexer through the site's own address" first (untested on Vercel).
# INDEXER_PROXY_TARGET=

# The beta instance's covenant ID (64 hex digits; `tn10 beta genesis` prints it, the launch bundle names it).
VITE_COVENANT_ID=2b86171b385bb93ffb7726994ba83901a7732af432c2c583aaa45cce6401ec00

# blake2b-256 of the launch bundle file the indexer serves at /v1/instance (64 hex digits).
VITE_BUNDLE_HASH=d10bb199b12967b46edd94d0a2c3d9f29bd998bbf5f01f344c55747ff7095d60

# The site owner's referral address, the default referrer (spec 7). A kaspatest: address.
VITE_REFERRAL_ADDRESS=kaspatest:qz2cr4g5262katpapg4djvpvgakltuv5h99dedl4hh5ktluvke6pza8pa3h2f

# The testnet-10 block explorer (transactions at <url>/txs/<id>, addresses at <url>/addresses/<a>). https only.
# F6 part F (2026-10-28): https://explorer-tn10.kaspa.org answers 402 DEPLOYMENT_DISABLED; https://tn10.kaspa.stream
# shows testnet-10 transactions (checked with the genesis txid); the page links its /transactions/ pages
# (src/lib/explorer.ts).
VITE_EXPLORER_URL=https://tn10.kaspa.stream

# The faucet link on the quick wallet's sheet (owner, 2026-10-26).
VITE_FAUCET_LINK=https://faucet-tn10.kaspanet.io

# Optional: one fixed node (wss://...). Unset: a public testnet-10 node from the rusty-kaspa resolver (the CSP then
# allows the resolver's four domains; with a fixed node it allows only that node's origin).
# VITE_NODE_URL=

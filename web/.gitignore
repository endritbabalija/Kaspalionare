# Front end build outputs and tools (F3)
node_modules/
dist/
dist-mainnet-check/
dist-dev-check/
dist-csp-check/
# Generated by scripts/wasm.mjs from crates/web (wasm-bindgen output; the .d.ts is the page's type source)
src/wasm/dev/
src/wasm/release/
src/wasm/mainnet/
# Playwright
playwright-report/
test-results/
.playwright-browsers/
# Vite and TypeScript caches
*.tsbuildinfo
.vite/
# Vercel CLI (F6 part C): the linked project and vercel build's output (.vercel/output), never committed
.vercel/
# Build configuration (F6 security review): web/.env.production is committed on purpose: every value in it is
# public (it ends up in the page). Vite's local overrides (.env.local, .env.production.local) are never committed,
# so what is built is what the repository shows.
.env.local
.env.*.local

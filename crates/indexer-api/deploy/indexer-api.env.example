# The hosted indexer API's settings (crates/indexer-api/src/config.rs; docs/launch/indexer-server.md).
# Copy to /etc/kaspalionare/indexer-api.env (systemd) or next to compose.yaml as indexer-api.env (Docker).
# Nothing here is secret: the server holds no keys and makes no transactions.

# The beta instance's covenant ID (64 hex digits; `tn10 beta genesis` prints it).
INDEXER_API_COV=

# The store: the directory holding index-log.jsonl, index.json and bundle.json (copied from the PC that ran
# the genesis, tn10-data/beta/<covenant ID>/). In the container it is /data.
INDEXER_API_STORE=/data

# The one-process mode: follow a testnet-10 node. `resolver` = a public node chosen by the rusty-kaspa resolver
# (kept for the whole run: every reconnect goes to the same node); or a node's Borsh wRPC URL, e.g.
# wss://<host>/kaspa/testnet-10/wrpc/borsh (your own node: docs/launch/indexer-server.md). Never a mainnet node.
INDEXER_API_NODE=resolver

# A second, independent node that must report the same chain blocks and transactions before anything is written to
# the store (F6 security review): `resolver` = another public node than the one above; or a node's URL; or `off` (one
# node, unchecked: a bad node could then write into the store until it is rebuilt). Required for testnet-10.
INDEXER_API_WITNESS=resolver

# Only for a store that has no index-log.jsonl yet: the chain block to start reading from (before genesis).
# INDEXER_API_START=

# Listen on loopback only; Caddy (on the same machine) faces the internet with HTTPS.
INDEXER_API_BIND=127.0.0.1:8790

# The client is the last X-Forwarded-For entry Caddy adds (only trusted from a loopback peer).
INDEXER_API_CLIENT_IP=forwarded

# CORS: the site's origin only (the Vercel address and/or the site's own domain), comma-separated.
INDEXER_API_ALLOW_ORIGIN=https://kaspalionare.vercel.app

# Per-client limits: a burst of 120 requests, then 20 a second (a page load uses a few dozen).
INDEXER_API_PER_CLIENT_BURST=120
INDEXER_API_PER_CLIENT_RATE=20
# At most this many requests of one client at once (of 64 in all); anchor-proof requests wait in their own pool of 32.
INDEXER_API_PER_CLIENT_INFLIGHT=16
INDEXER_API_MAX_ANCHOR_WAITS=32

# /health turns 503 when the node was not read for this long (ms).
INDEXER_API_STALE_MS=120000
